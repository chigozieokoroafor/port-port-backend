# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/port2port

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Stripe
# STRIPE_WEBHOOK_SECRET: from `stripe listen` locally, or the Dashboard Webhooks
# section in production. The webhook endpoint is POST /stripe/webhook.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paypal
PAYPAL_SECRET_KEY=sk_test_...
PAYPAL_WEBHOOK_SECRET=whsec_...

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@port2port.com

# Email Configuration 
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM_EMAIL=noreply@port2port.com
SMTP_SECURE=false  # true for port 465, false for 587/2525

# For production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=port2port-documents

# Admin
SUPERADMIN_EMAIL=admin@port2port.com
SUPERADMIN_PASSWORD=change-this-password
